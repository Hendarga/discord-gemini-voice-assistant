# ===== ОБЯЗАТЕЛЬНЫЕ =====

# Токен аккаунта Discord (self-bot)
DISCORD_BOT_TOKEN=токен_аккаунта_discord

# Ключ Gemini
GEMINI_API_KEY=твой_ключ_gemini

# Модель Gemini
GEMINI_MODEL=gemini-2.0-flash-lite

# ===== ЛИЧНОСТЬ БОТА =====

SYSTEM_PROMPT=Ты — полезный ИИ-ассистент. Отвечай кратко и по делу.

# ===== ПРАВА =====

# Твой Discord ID (владелец — команды ! и ~)
OWNER_ID=1121431968022798347

# ID администраторов (через запятую) — могут !stop, !start, !clear
ADMIN_IDS=1121431968022798347

# Триггер-слова для реакции в общих каналах (через запятую)
TRIGGER_WORDS=бот,bot

# ID пользователей которых бот ТАРГЕТИТ:
#   — отвечает коротко (3-4 предложения)
#   — автоматически заходит в их голосовой канал
#   — кулдаун между ответами
TARGET_IDS=812076585678798900,664509411905110028,751919891329843374

# Кулдаун для TARGET_IDS (секунды, по умолчанию 180)
TARGET_COOLDOWN=180

# ===== TTS НАСТРОЙКИ =====

# Включить/выключить голосовые ответы (true/false)
TTS_ENABLED=true

# Голос edge-tts (примеры ниже):
#   ja-JP-NanamiNeural   — японский женский (аниме) [по умолчанию]
#   ru-RU-SvetlanaNeural — русский женский
#   ru-RU-DariyaNeural   — русский молодой женский
#   ru-RU-DmitryNeural   — русский мужской
TTS_VOICE=ja-JP-NanamiNeural

# Скорость речи (+10% быстрее, -10% медленнее)
TTS_RATE=+10%

# ===== STT НАСТРОЙКИ =====

# Размер Whisper модели (tiny/base/small/medium):
#   tiny  — быстро, менее точно (хватит для Render free)
#   base  — хорошо, рекомендуется
#   small — точнее, требует больше памяти
WHISPER_MODEL=base

# Язык распознавания (ru/en/ja/auto)
WHISPER_LANGUAGE=ru

# ===== RENDER (НЕ ТРОГАТЬ ВРУЧНУЮ) =====

# RENDER_EXTERNAL_URL — проставляется Render автоматически
