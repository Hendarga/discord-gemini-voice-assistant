# Required settings
# Copy this file to .env and fill in real values before running the bot.

# Discord account token used by the bot.
DISCORD_BOT_TOKEN=your_discord_token

# Gemini API key used for conversational replies.
GEMINI_API_KEY=your_gemini_api_key

# Gemini model to use for chat generation.
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional fallback model if the primary model is unavailable or rejected.
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# Bot identity settings
# OWNER_ID is used for DM-based admin controls and DM logs; keep it at 0 unless you need it.
OWNER_ID=0

# Only used for targeting a specific guild when auto-join is enabled.
TARGET_GUILD_ID=0

# Comma-separated list of admin user IDs that can use restricted controls.
ADMIN_IDS=

# Prompt used to define the bot's personality and tone. Leave empty for no system prompt.
SYSTEM_PROMPT=

# Extra instructions applied only to voice replies. Leave empty to disable them.
VOICE_MODE_PROMPT=

# Comma-separated trigger words for automatic reaction in general chat. Leave empty to disable them.
TRIGGER_WORDS=

# Comma-separated target user IDs. If left empty, the bot will not auto-target a specific user.
TARGET_IDS=

# Cooldown in seconds between auto-responses for targeted users.
TARGET_COOLDOWN=180

# DM logs are off by default to avoid sending private logs to your account.
DM_LOGS_ENABLED=false

# Optional legacy Russian commands; keep disabled unless you intentionally want them.
ALLOW_LEGACY_COMMANDS=false

# TTS settings
# Enable or disable the bot's spoken responses.
TTS_ENABLED=true

# Priority order for text-to-speech providers. Supported values: edge, elevenlabs, openai
TTS_PROVIDER=edge
TTS_PROVIDER_PRIORITY=edge,elevenlabs,openai

# Edge TTS voice. Examples:
# ja-JP-NanamiNeural   -> anime / cute Japanese female voice (default)
# ru-RU-SvetlanaNeural -> Russian female voice
# ru-RU-DariyaNeural   -> Russian female voice
# zh-CN-XiaoxiaoNeural -> warm, friendly Chinese female voice
TTS_VOICE=ja-JP-NanamiNeural

# Speech rate and pitch for Edge TTS.
TTS_RATE=+8%
TTS_PITCH=+120Hz

# Optional ElevenLabs settings.
# ELEVENLABS_API_KEY=your_elevenlabs_key
# ELEVENLABS_VOICE_ID=your_voice_id
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional OpenAI TTS settings.
# OPENAI_API_KEY=your_openai_key
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Speech-to-text settings
# Language for Google Speech Recognition. Example values: ru-RU, en-US, ja-JP.
STT_LANGUAGE=ru-RU

# Buffering behavior to prevent chopping speech mid-phrase.
VOICE_PHRASE_TIME_LIMIT=12
VOICE_BUFFER_DELAY=2.0
VOICE_BUFFER_MAX_CHARS=260

# Enable detailed local voice debugging prints.
VOICE_DEBUG=true

# Deployment / hosting
# Render sets PORT automatically; if you run it locally, leave this at 10000 unless needed.
PORT=10000

# Optional external URL for Render health checks.
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
